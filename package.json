{
  "name": "invoice-generator",
  "version": "1.0.0",
  "description": "Limousine invoice generator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable",
    "build:web": "node scripts/build-web.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.invoicegenerator",
    "productName": "Invoice Generator",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "vendor/**"
    ],
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Invoice Generator Setup.exe"
    },
    "portable": {
      "artifactName": "Invoice Generator.exe"
    }
  }
}
